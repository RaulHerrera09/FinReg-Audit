# FinReg Audit Platform — Environment Variables
# Copy this file to .env and fill in values for local development.
# NEVER commit .env — only .env.example with placeholder values.

# PostgreSQL connection string
# Local Docker:  Host=localhost;Port=5432;Database=finreg;Username=finreg;Password=finreg_dev_password
# Supabase prod: Host=aws-0-eu-west-2.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.yourref;Password=yourpassword;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20
DATABASE_URL=Host=localhost;Port=5432;Database=finreg;Username=finreg;Password=finreg_dev_password

# JWT configuration
# JWT_SECRET must be at least 32 characters. Use a cryptographically random value in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=finreg-audit-platform
JWT_AUDIENCE=finreg-audit-api

# Frontend API base URL (used by Vite at build time)
# Local development: http://localhost:5000
# Production: https://your-app-name.fly.dev
VITE_API_BASE_URL=http://localhost:5000

# ASP.NET Core environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
